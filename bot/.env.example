# Claves del exchange (sólo necesarias en mode=live). Permisos: SOLO trading spot, SIN retiros.
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
# Algunos exchanges (OKX, KuCoin, Bitget) piden además una passphrase:
EXCHANGE_PASSWORD=

# Telegram: creá un bot con @BotFather y obtené tu chat_id con @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Panel web (usuario y contraseña para la página de estado)
WEB_USER=admin
WEB_PASS=cambiame

# Upstash Redis (para la web en Vercel). Las da el Marketplace de Vercel o la consola de Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
